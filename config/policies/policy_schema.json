{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Demand Planning Policy Schema",
  "description": "Schema for policy configuration versioning",
  "type": "object",
  "required": [
    "schema_version",
    "policy_version",
    "created_at",
    "created_by",
    "change_summary",
    "exception_detection",
    "decision_generation",
    "scoring_weights",
    "tier_boundaries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version for compatibility"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of policy (e.g., v1.0.0)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "created_by": {
      "type": "string",
      "description": "Creator identifier (user, system, calibration_bot)"
    },
    "change_summary": {
      "type": "string",
      "description": "Human-readable summary of changes"
    },
    "exception_detection": {
      "type": "object",
      "description": "Thresholds for exception detection stage",
      "required": [
        "low_confidence_threshold",
        "change_ratio_threshold",
        "volatility_threshold",
        "band_ratio_threshold"
      ],
      "properties": {
        "low_confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "change_ratio_threshold": {"type": "number", "minimum": 0},
        "volatility_threshold": {"type": "number", "minimum": 0},
        "band_ratio_threshold": {"type": "number", "minimum": 0},
        "zscore_threshold": {"type": "number", "minimum": 0},
        "high_confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "decision_generation": {
      "type": "object",
      "description": "Thresholds for decision generation stage",
      "required": [
        "low_confidence_threshold",
        "big_change_threshold",
        "volatility_threshold",
        "wide_band_threshold",
        "multi_flag_penalty",
        "single_flag_penalty"
      ],
      "properties": {
        "low_confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "big_change_threshold": {"type": "number", "minimum": 0},
        "volatility_threshold": {"type": "number", "minimum": 0},
        "wide_band_threshold": {"type": "number", "minimum": 0},
        "multi_flag_penalty": {"type": "number", "minimum": 0, "maximum": 1},
        "single_flag_penalty": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "scoring_weights": {
      "type": "object",
      "description": "Weights for priority scoring",
      "required": ["change", "volatility", "band", "low_confidence", "diminishing_returns"],
      "properties": {
        "change": {"type": "number", "minimum": 0},
        "volatility": {"type": "number", "minimum": 0},
        "band": {"type": "number", "minimum": 0},
        "low_confidence": {"type": "number", "minimum": 0},
        "diminishing_returns": {
          "type": "array",
          "items": {"type": "number", "minimum": 0, "maximum": 1},
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "tier_boundaries": {
      "type": "object",
      "description": "Percentile boundaries for priority tiers",
      "required": ["critical", "high", "medium"],
      "properties": {
        "critical": {"type": "number", "minimum": 0, "maximum": 1},
        "high": {"type": "number", "minimum": 0, "maximum": 1},
        "medium": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "calibration": {
      "type": "object",
      "description": "Calibration-related thresholds",
      "properties": {
        "calibration_gap_threshold": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
